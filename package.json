{
  "name": "cs2-surf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "First-person browser surf game with a faithful port of Source / CS2 surf-server movement.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
